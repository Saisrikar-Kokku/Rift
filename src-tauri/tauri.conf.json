{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rift",
  "version": "1.0.0",
  "identifier": "com.rift.dictation",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "widget",
        "title": "Rift Widget",
        "url": "widget/widget.html",
        "width": 190,
        "height": 60,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": true
      },
      {
        "label": "main",
        "title": "Rift",
        "url": "index.html",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 580,
        "visible": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/tray_icon.png"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist"
    }
  }
}
